{
  "name": "minimal-deploy",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "quickservicets build",
    "build:server": "quickservicets build --target server",
    "build:binary": "quickservicets build --target binary",
    "build:lambda": "quickservicets build --target lambda",
    "build:azure": "quickservicets build --target azure-functions",
