{
  "name": "@quickservicets/core",
  "version": "0.1.0",
  "description": "The QuickService.ts runtime: build typed, validated and documented REST APIs on Bun from TypeScript entity types.",
  "keywords": [
    "quickservicets",
    "bun",
    "typescript",
    "rest",
    "api",
    "backend",
    "framework",
    "crud",
    "openapi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardorauber/quickservicets.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ricardorauber/quickservicets#readme",
  "bugs": {
    "url": "https://github.com/ricardorauber/quickservicets/issues"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./features/*": "./src/features/*"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-support.ts",
    "!src/**/*-test-support.ts",
    "!src/**/__snapshots__",
    "!src/**/fixtures",
    "!src/**/.generated",
    "README.md",
    "LICENSE"
  ]
}
