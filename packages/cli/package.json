{
  "name": "@quickservicets/cli",
  "version": "0.2.0",
  "description": "The quickservicets command: create, build, run and migrate QuickService.ts projects.",
  "keywords": [
    "quickservicets",
    "bun",
    "typescript",
    "cli",
    "rest",
    "api",
    "backend",
    "migrations",
    "openapi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardorauber/quickservicets.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ricardorauber/quickservicets#readme",
  "bugs": {
    "url": "https://github.com/ricardorauber/quickservicets/issues"
  },
  "type": "module",
  "bin": {
    "quickservicets": "src/index.ts"
  },
  "exports": {
    ".": "./src/lib.ts",
    "./testing": "./src/testing/index.ts",
    "./bin": "./src/index.ts"
  },
  "dependencies": {
    "@quickservicets/core": "workspace:*",
    "typescript": "5.9.2",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@scalar/openapi-parser": "0.29.9",
    "mongodb": "7.7.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-support.ts",
    "!src/**/*-test-support.ts",
    "!src/**/__snapshots__",
    "!src/**/fixtures",
    "!src/**/.generated",
    "agent-docs",
    "README.md",
    "LICENSE"
  ]
}
