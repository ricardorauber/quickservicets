{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "quickservicets.config.ts",
    "entities",
    "endpoints",
    "hooks",
    "jobs",
    "lib",
    "scripts",
    "tests",
    ".generated/**/*.ts"
  ]
}
